async (page) => {
  const checks = [];
  const errors = [];
  const onError = error => errors.push(error.message);
  page.on("pageerror", onError);
  const assert = (ok, label) => { if (!ok) throw Error(label); checks.push(label); };
  const icon = name => page.locator(`svg[data-icon="${name}"]`).first();
  const download = async format => {
    await page.getByLabel("내보내기 형식").selectOption(format);
    const pending = page.waitForEvent("download");
    await icon("file-export").click();
    const file = await pending;
    const stream = await file.createReadStream();
    let hex = "";
    for await (const chunk of stream) hex += chunk.toString("hex");
    assert(file.suggestedFilename().endsWith(`.${format}`), `${format} filename`);
    return hex;
  };
  const pixels = hex => page.evaluate(async hex => {
    const bytes = Uint8Array.from(hex.match(/../g), pair => parseInt(pair,16));
    const bitmap = await createImageBitmap(new Blob([bytes]));
    const canvas = document.createElement("canvas");
    canvas.width = bitmap.width; canvas.height = bitmap.height;
    const context = canvas.getContext("2d");
    context.drawImage(bitmap,0,0); bitmap.close();
    const data = context.getImageData(0,0,canvas.width,canvas.height).data;
    return {width:canvas.width,height:canvas.height,corner:Array.from(data.slice(0,4)),opaque:data.some((v,i)=>i%4===3&&v===255)};
  }, hex);
  try {
    await page.setViewportSize({width:1920,height:1000});
    await page.reload();
    await page.locator("#mapCanvas").waitFor();
    await page.locator(".logo-wrapper").waitFor({state:"hidden"});
    const size = await page.locator(".map-surface").evaluate(el=>({width:parseFloat(el.style.width),height:parseFloat(el.style.height)}));
    const png = await download("png");
    assert(png.startsWith("89504e470d0a1a0a"), "PNG signature");
    const image = await pixels(png);
    assert(image.width===size.width&&image.height===size.height&&image.opaque, "full resolution nonempty PNG");
    assert(image.corner[3]===0, "PNG transparent empty corner");
    await icon("mountain").click();
    await page.mouse.move(1900,950);
    assert(await page.evaluate(async hex => {
      const bytes=Uint8Array.from(hex.match(/../g),pair=>parseInt(pair,16));
      const bitmap=await createImageBitmap(new Blob([bytes]));
      const canvas=document.createElement("canvas");
      canvas.width=bitmap.width; canvas.height=bitmap.height;
      const context=canvas.getContext("2d");
      context.fillStyle="#333"; context.fillRect(0,0,canvas.width,canvas.height);
      context.drawImage(bitmap,0,0); bitmap.close();
      return canvas.toDataURL()===document.querySelector("#mapCanvas").toDataURL();
    },png), "PNG composites all layers exactly like full map preview");
    await page.getByRole("slider").fill("0.5");
    await page.getByText("Layer 3",{exact:true}).click();
    assert(await download("png")===png, "zoom and active layer do not alter exported pixels");
    await icon("mountain").click();
    assert(await download("png")===png, "preview and editing exports match");
    const jpg = await download("jpg");
    assert(jpg.startsWith("ffd8")&&jpg.endsWith("ffd9"), "JPEG signature");
    const jpeg = await pixels(jpg);
    assert(jpeg.width===size.width&&jpeg.height===size.height, "JPEG original resolution");
    assert(jpeg.corner.every((v,i)=>Math.abs(v-(i===3?255:51))<=2), "JPEG fills transparent area with editor background");
    const webp = await download("webp");
    assert(webp.startsWith("52494646")&&webp.slice(16,24)==="57454250", "WebP signature");
    const webpImage = await pixels(webp);
    assert(webpImage.width===size.width&&webpImage.height===size.height&&webpImage.corner[3]===0, "WebP size and transparency");
    await page.getByText("Layer 1",{exact:true}).click();
    await icon("bullseye").click();
    const palette=await page.locator("#tilesetCanvas").boundingBox();
    await page.mouse.click(palette.x+palette.width*1.5/8,palette.y+48*palette.width/256);
    const map=await page.locator("#mapCanvas").boundingBox();
    await page.mouse.click(map.x+176,map.y+176);
    assert(await download("png")!==png, "unsaved drawing included in PNG");
    await icon("arrow-rotate-left").click();
    assert(await download("png")===png, "undo restores exported pixels");
    await page.evaluate(()=>{ HTMLCanvasElement.prototype.toBlob=function(callback){callback(null);}; });
    await icon("file-export").click();
    await page.getByRole("status").filter({hasText:"내보내지 못했습니다"}).waitFor();
    assert(true, "encoding failure is visible");
    assert(errors.length===0, `no runtime errors: ${errors.join("; ")}`);
    return {passed:checks.length,checks};
  } finally {
    page.off("pageerror",onError);
    await page.reload();
  }
}
