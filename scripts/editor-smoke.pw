async (page) => {
  const checks = [];
  const errors = [];
  const onError = (error) => errors.push(error.message);
  const onConsole = (message) => {
    if (["error", "warning"].includes(message.type())) errors.push(message.text());
  };
  page.on("pageerror", onError);
  page.on("console", onConsole);
  const assert = (condition, message) => {
    if (!condition) throw new Error(message);
    checks.push(message);
  };
  const state = () =>
    page.locator("#mapCanvas").evaluate((canvas) => {
      const editor = canvas.__vueParentComponent.proxy;
      return {
        layers: JSON.parse(JSON.stringify(editor.maps[editor.activeMap].data)),
        selected: JSON.parse(JSON.stringify(editor.selectedTiles)),
        selection: JSON.parse(JSON.stringify(editor.select)),
        layer: editor.activeLayer,
        zoom: editor.zoom,
        history: editor.$store.state.mapHistory.length,
        future: editor.$store.state.mapFuture.length,
      };
    });
  const icon = (name) => page.locator(`svg[data-icon="${name}"]`).first();
  const point = async (selector, x, y) => {
    if (selector !== "#mapCanvas") {
      await page.locator("#tileset").evaluate(el => el.scrollTo({top: 0, behavior: "instant"}));
    }
    const box = await page.locator(selector).boundingBox();
    const size = await page.locator(selector).evaluate((el) => ({
      width: el.width,
      height: el.height,
    }));
    const zoom = selector === "#mapCanvas" ? (await state()).zoom : 1;
    return {
      x: box.x + ((x + 0.5) * 32 * zoom * box.width) / size.width,
      y: box.y + ((y + 0.5) * 32 * zoom * box.height) / size.height,
    };
  };
  const clickTile = async (selector, x, y, button = "left") => {
    const p = await point(selector, x, y);
    await page.mouse.click(p.x, p.y, { button });
  };
  const drag = async (selector, x1, y1, x2, y2) => {
    const a = await point(selector, x1, y1);
    const b = await point(selector, x2, y2);
    await page.mouse.move(a.x, a.y);
    await page.mouse.down();
    await page.mouse.move(b.x, b.y, { steps: 12 });
    await page.mouse.up();
  };
  try {
    await page.setViewportSize({ width: 1920, height: 1000 });
    await page.reload();
    await page.locator(".logo-wrapper").waitFor({ state: "hidden" });
    await page.locator("#tilesetCanvas").waitFor();
    const initial = await state();
    await clickTile("#tilesetCanvas", 1, 1);
    assert((await state()).selected[0].id === 393, "single tile selection");
    await drag("#tilesetCanvas", 1, 1, 2, 2);
    assert((await state()).selected.length === 4, "2x2 tile selection");
    await clickTile("#tilesetCanvas", 7, 0);
    assert((await state()).selected[0].id === 391, "rightmost palette column");
    const palette = await page.locator("#tilesetCanvas").boundingBox();
    await page.mouse.click(palette.x + palette.width - 1, palette.y + 10);
    assert((await state()).selected[0].id === 391, "scaled palette right edge");
    await clickTile("#tilesetCanvas", 1, 1);
    await clickTile("#mapCanvas", 5, 5);
    assert((await state()).layers[0][5][5] === 393, "brush commits tile");
    await icon("arrow-rotate-left").click();
    assert(
      (await state()).layers[0][5][5] === initial.layers[0][5][5],
      "toolbar undo restores original"
    );
    await icon("arrow-rotate-right").click();
    assert((await state()).layers[0][5][5] === 393, "toolbar redo restores edit");
    await page.getByText("Layer 2", { exact: true }).click();
    await icon("arrow-rotate-left").click();
    const cross = await state();
    assert(
      cross.layers[0][5][5] === initial.layers[0][5][5] &&
        cross.layers[1][5][5] === initial.layers[1][5][5],
      "cross-layer undo targets original layer"
    );
    await icon("arrow-rotate-right").click();
    assert((await state()).layers[0][5][5] === 393, "cross-layer redo");
    for (const layer of [2, 3]) {
      await page.getByText(`Layer ${layer}`, { exact: true }).click();
      await clickTile("#mapCanvas", 6, 5);
      assert((await state()).layers[layer - 1][5][6] === 393, `layer ${layer} drawing`);
    }
    await page.keyboard.press("Control+z");
    assert((await state()).layers[2][5][6] === initial.layers[2][5][6], "keyboard undo");
    await page.keyboard.press("Control+Shift+z");
    assert((await state()).layers[2][5][6] === 393, "keyboard redo");
    await page.keyboard.press("Control+z");
    await clickTile("#mapCanvas", 7, 5);
    assert((await state()).future === 0, "new edit clears redo");
    await page.getByText("Layer 1", { exact: true }).click();
    await icon("square-full").click();
    await drag("#mapCanvas", 8, 5, 10, 7);
    const square = await state();
    assert(square.layers[0].slice(5, 8).every(row => row.slice(8, 11).every(id => id === 393)), "rectangle drawing");
    await icon("circle").click();
    await drag("#mapCanvas", 12, 5, 16, 9);
    assert((await state()).layers[0][7][14] === 393, "ellipse drawing");
    await clickTile("#tilesetCanvas", 2, 1);
    await icon("fill-drip").click();
    await clickTile("#mapCanvas", 9, 6);
    assert((await state()).layers[0][6][9] === 394, "fill drawing");
    await icon("pencil").click();
    await clickTile("#mapCanvas", 9, 6, "right");
    assert((await state()).selected[0].id === 394, "map eyedropper selection");
    await icon("draw-polygon").click();
    await drag("#mapCanvas", 8, 5, 10, 7);
    assert((await state()).selection[0].length === 9, "map rectangle selection");
    await icon("pencil").click();
    await page.getByRole("slider").fill("0.5");
    assert((await state()).zoom === 0.5, "zoom slider");
    await clickTile("#mapCanvas", 20, 10);
    assert((await state()).layers[0][10][20] === 394, "drawing at half zoom");
    await icon("magnifying-glass-plus").click();
    assert((await state()).zoom === 0.6, "zoom in");
    await icon("magnifying-glass-minus").click();
    assert((await state()).zoom === 0.5, "zoom out");
    await icon("bullseye").click();
    assert((await state()).zoom === 1, "reset zoom");
    for (const name of ["mountain", "street-view"]) {
      await icon(name).click();
      const before = await state();
      await clickTile("#mapCanvas", 5, 5);
      await clickTile("#mapCanvas", 5, 5, "right");
      assert(JSON.stringify((await state()).layers) === JSON.stringify(before.layers), `${name} is read-only`);
    }
    await page.getByText("Layer 1", { exact: true }).click();
    await icon("pencil").click();
    await clickTile("#autotileCanvas", 1, 0);
    assert((await state()).selected[0].id === 95, "autotile palette selection");
    const beforeAuto = await state();
    await drag("#mapCanvas", 22, 10, 25, 10);
    const afterAuto = await state();
    assert(afterAuto.layers[0][10].slice(22, 26).every(id => id >= 48 && id < 96), "autotile drag brush");
    await icon("arrow-rotate-left").click();
    assert(JSON.stringify((await state()).layers) === JSON.stringify(beforeAuto.layers), "autotile undo restores neighbors exactly");
    await icon("arrow-rotate-right").click();
    assert(JSON.stringify((await state()).layers) === JSON.stringify(afterAuto.layers), "autotile redo restores neighbors exactly");
    await drag("#tilesetCanvas", 1, 1, 2, 2);
    await clickTile("#mapCanvas", 30, 10);
    const stamped = await state();
    assert(stamped.layers[0][10][30] === 393 && stamped.layers[0][10][31] === 394 && stamped.layers[0][11][30] === 401 && stamped.layers[0][11][31] === 402, "2x2 brush stamp");
    await page.getByRole("slider").fill("0.1");
    await icon("magnifying-glass-minus").click();
    assert((await state()).zoom === 0.1, "minimum zoom clamped");
    await page.getByRole("slider").fill("1");
    await icon("magnifying-glass-plus").click();
    assert((await state()).zoom === 1, "maximum zoom clamped");
    const finalLayers = (await state()).layers;
    const undoCount = (await state()).history;
    for (let i = 0; i < undoCount; i++) await icon("arrow-rotate-left").click();
    assert(JSON.stringify((await state()).layers) === JSON.stringify(initial.layers), "undo entire editing session");
    for (let i = 0; i < undoCount; i++) await icon("arrow-rotate-right").click();
    assert(JSON.stringify((await state()).layers) === JSON.stringify(finalLayers), "redo entire editing session");
    await page.mouse.move(1900, 950);
    await page.screenshot({ path: "output/playwright/editor-smoke.png" });
    assert(errors.length === 0, `no runtime errors: ${errors.join("; ")}`);
    return { passed: checks.length, checks };
  } finally {
    page.off("pageerror", onError);
    page.off("console", onConsole);
  }
}
