async (page) => { await page.reload(); await page.addScriptTag({url:'/performance-before.js'}); await page.evaluate(async()=>{await window.usagiBenchmark.ready;window.usagiBefore=window.usagiBenchmark;}); await page.addScriptTag({url:'/performance-harness.js'}); await page.evaluate(()=>window.usagiBenchmark.ready); return {checks:await page.evaluate(()=>window.usagiBenchmark.exportChecks()),random:await page.evaluate(()=>window.usagiBenchmark.workerParity())}; }
